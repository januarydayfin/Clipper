<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/colorOnPrimary"
    android:orientation="vertical">

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recycler"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:paddingHorizontal="26dp"
        android:paddingTop="@dimen/base_top_margin"
        android:paddingBottom="12dp"
        android:visibility="gone"
        tools:listitem="@layout/adapter_item" />

    <TextView
        android:id="@+id/empty_hint"
        style="@style/HeadlineSmall"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/base_screen_margin"
        android:text="@string/empty_hint"
        android:textAlignment="center"
        android:textColor="?attr/colorOnSurface"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.3" />

    <Button
        android:id="@+id/startScanner"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Start Scanner" />

    <Button
        android:id="@+id/createCustom"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="CreateCustom barcode" />

    <Button
        android:id="@+id/colorPicker"
        android:layout_width="wrap_content"
        android:text="Color picker"
        android:layout_height="wrap_content"/>

</LinearLayout>